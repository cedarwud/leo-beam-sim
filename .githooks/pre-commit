#!/usr/bin/env bash
#
# leo-beam-sim — render-governance pre-commit gate.
#
# Mechanically enforces the frontend render-governance rules (the
# display<->truth boundary the S0-S5 consolidation established) on EVERY commit,
# by EVERY committer — Claude, Codex, any other agent, or a human. The rules
# live in docs/frontend-render-governance.md + ADR-001 as prose, but prose is
# only advisory; this hook is what binds an agent that did not read (or cannot
# remember) them. It runs the load-bearing foundation guards:
#   - lint (tsc --noEmit)            — types intact
#   - scene-lane-governance          — Rule#1-9 (one viewport = one lane, etc.)
#   - s0:connected-sat-has-beam      — the serving must-hold invariant
#   - s0:geometry-trace              — truth zero-diff vs the golden (no drift)
#   - beam:colour-match              — cone colour == its served UE's colour
#                                      (fast VISUAL-truth invariant, ~0.8s, non-
#                                      browser; closes the loop-3 gate<->UX gap)
#
# A breaking change fails the commit. This is the ~16s foundation set, NOT the
# full 200+ validator suite (browser/feature gates run separately / in review).
#
# Activate once per clone:  npm run setup:hooks   (sets core.hooksPath=.githooks)
# Genuine WIP escape hatch:  git commit --no-verify   (discouraged — you own it)
set -euo pipefail

echo "[pre-commit] render-governance gate (npm run validate:governance) ..."
if ! npm run --silent validate:governance; then
  echo ""
  echo "[pre-commit] BLOCKED — a render-governance guard failed (see above)."
  echo "[pre-commit] Fix it, or 'git commit --no-verify' only if you are certain"
  echo "[pre-commit] the failure is unrelated + pre-existing. Do not normalize bypass."
  exit 1
fi
echo "[pre-commit] render-governance gate PASSED."
