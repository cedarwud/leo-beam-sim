{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/devkit-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "devkit: 種子/版本/提醒"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/devkit-session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
